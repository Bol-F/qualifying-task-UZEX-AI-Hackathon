DATA_MODE=demo
# Use local for the README2 synthetic CSV registry after npm run import:registry.
LOCAL_DATA_PATH=data/registry.sqlite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set local for repeatable, unpaid demo/testing; auto uses Gemini when configured.
AI_MODE=auto
# Set a strong secret on production; clients supply x-api-key for private datasets.
APP_API_KEY=
# Required on Vercel: at least 32 random characters for expiring conversation checkpoints.
AGENT_STATE_SECRET=
